name: {{SERVICE}} checks

on:
  pull_request:
    paths:
      - "api/sindri/{{SERVICE}}/**"
      - "gen/go/{{SERVICE}}/**"
      - "pkg/{{SERVICE}}/**"
      - "cmd/{{SERVICE}}/**"
      - "internal/{{SERVICE}}/**"
      - "configs/{{SERVICE}}.yaml"
      - "migrations/{{SERVICE}}/**"
      - "tests/{{SERVICE}}/**"
      - "internal/pkg/**"
      - "go.work"
      - "go.work.sum"
      - "Makefile"

permissions:
  contents: read

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache-dependency-path: |
            go.sum
            gen/go/{{SERVICE}}/go.sum
            pkg/{{SERVICE}}/go.sum
      - run: make proto-lint
      - run: make test build modules-check SERVICE={{SERVICE}}
