//go:generate sh ../../scripts/generate-wire.sh
//go:build wireinject

package main

import (
	"github.com/codesjoy/yggdrasil/v3"
	"github.com/google/wire"
)

// provideBusinessBundle is the seed of the service's composition. Providers for
// the service's own components are added here as they appear, and
// `task wire SERVICE={{SERVICE}}` regenerates wire_gen.go from this file. Wiring
// this bundle into the Yggdrasil runtime in main.go is the service's first change.
func provideBusinessBundle() *yggdrasil.BusinessBundle {
	return &yggdrasil.BusinessBundle{}
}

func initializeService(_ yggdrasil.Runtime) (*yggdrasil.BusinessBundle, error) {
	wire.Build(provideBusinessBundle)
	return nil, nil
}
