# Sequence application
SKULD_SEQUENCE_DRIVER=postgres
SKULD_SEQUENCE_NODE_ID=sequence-1
SKULD_SEQUENCE_GRPC_PORT=19010
SKULD_SEQUENCE_DB_PASSWORD=skuld-local

# The default compose file uses these local PostgreSQL values.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres-local

# OTLP gRPC endpoint as seen from the sequence container.
SKULD_OTLP_ENDPOINT=otel-collector:4317

# Local observability UI
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Optional image overrides
# SKULD_SEQUENCE_IMAGE=ghcr.io/example/skuld-sequence:latest
# SKULD_MIGRATE_IMAGE=ghcr.io/example/skuld-sequence-migrate:latest
# POSTGRES_IMAGE=postgres:16-alpine
# OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.132.0
# PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
# TEMPO_IMAGE=grafana/tempo:2.8.2
# GRAFANA_IMAGE=grafana/grafana:12.1.0
